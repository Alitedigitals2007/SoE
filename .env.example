# Stadium of Elite environment — copy to .env and fill real values.

# --- Database (Neon Postgres) ---
# Create a project at neon.tech, grab the pooled connection string from
# Project > Connection Details > Prisma.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth.js ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"
# Must be true when running behind a proxy (Vercel) or on non-localhost
AUTH_TRUST_HOST="true"
# Base URL of the deployment, no trailing slash (used for callbacks)
AUTH_URL="http://localhost:3000"

# --- Realtime provider 1: Pusher (primary) ---
# https://dashboard.pusher.com  →  your Channels app → App Keys
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# --- Realtime provider 2: Ably (secondary fallback) ---
# https://ably.com  →  your app → API keys
ABLY_API_KEY=""
NEXT_PUBLIC_ABLY_KEY=""

# --- Seed admin (npm run db:seed) ---
SEED_ADMIN_EMAIL="admin@stadiumofelite.app"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Super Admin"
