generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ---------------------------------- Users ----------------------------------
 */

enum Role {
  ADMIN
  REFEREE
  PLAYER
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matchesRefereed  Match[]               @relation("MatchReferee")
  rosterSlots      MatchPlayer[]
  requestedSubs    SubstitutionRequest[]
  timelineAuthored TimelineEvent[]       @relation("TimelineAuthor")
  teams            TeamPlayer[]
  fantasyEntries   FantasyEntry[]
  potmVotes        PotmVote[]
  playerVotes      PotmVote[]            @relation("PlayerVotes")
  chatMessages     ChatMessage[]
}

/**
 * --------------------------------- Matches ---------------------------------
 */

enum MatchStatus {
  DRAFT // admin built the shell, referee may still be preparing questions
  LIVE // kicked off, rounds run until 10 are decided
  FINISHED // full time, summary available
}

enum TeamSide {
  HOME
  AWAY
}

model Match {
  id               String      @id @default(cuid())
  code             String      @unique
  homeName         String
  awayName         String
  status           MatchStatus @default(DRAFT)
  refereeId        String?
  referee          User?       @relation("MatchReferee", fields: [refereeId], references: [id], onDelete: SetNull)
  countdownSeconds Int         @default(15)

  // Optional tournament context. Friendly matches carry none of these.
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  homeTeamId    String?
  homeTeam      Team?        @relation("TeamHomeMatches", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeamId    String?
  awayTeam      Team?        @relation("TeamAwayMatches", fields: [awayTeamId], references: [id], onDelete: SetNull)
  cupRound      Int? // knockout round index, 1-based (1 = first round)

  // "20 prepared questions, 10 played": the played set is Rounds 1..10,
  // which reference the prepared bank. A round can only be created while in DRAFT.
  currentRound Int       @default(0) // number of rounds decided so far (0..10)
  version      Int       @default(0) // bumped on every state change for realtime
  startedAt    DateTime?
  finishedAt   DateTime?

  homeScore Int @default(0)
  awayScore Int @default(0)

  roster          MatchPlayer[]
  questions       Question[]
  rounds          Round[]
  requests        SubstitutionRequest[]
  substitutions   Substitution[]
  incidents       ConductIncident[]
  timeline        TimelineEvent[]
  potmVotes       PotmVote[]
  chatMessages    ChatMessage[]
  penaltyShootout PenaltyShootout?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([refereeId])
}

/**
 * ------------------------------ Roster / lineup -----------------------------
 */

enum LineupRole {
  STARTER // on the field, can answer
  SUB // on the bench, cannot answer until subbed in
  OUT // left the match (red card or otherwise removed)
}

model MatchPlayer {
  id        String     @id @default(cuid())
  matchId   String
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      TeamSide
  number    Int // shirt number, 1..8
  isCaptain Boolean    @default(false)
  role      LineupRole @default(STARTER)

  submissions Submission[]
  incidents   ConductIncident[]
  outInSubs   Substitution[]    @relation("SubPlayerOut")
  inInSubs    Substitution[]    @relation("SubPlayerIn")

  @@unique([matchId, userId])
  @@unique([matchId, team, number])
}

/**
 * ------------------------------- Question bank ------------------------------
 */

model Question {
  id              String @id @default(cuid())
  matchId         String
  match           Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  order           Int // 1-based position inside the bank as prepared by the referee
  text            String
  referenceAnswer String
  roundNumber     Int? // null = prepared but not part of the 10 to be played

  rounds Round[]

  @@unique([matchId, order])
  @@unique([matchId, roundNumber])
}

/**
 * --------------------------------- Rounds ----------------------------------
 */

enum RoundStatus {
  PENDING // set up in the played list, not yet shown
  OPEN // question live, countdown running, submissions accepted
  LOCKED // countdown over, answers frozen + revealed anonymously, waiting on referee
  DECIDED // referee chose a goal OR no-goal, reveal done
}

enum RoundDecision {
  GOAL
  NO_GOAL
}

model Round {
  id               String         @id @default(cuid())
  matchId          String
  match            Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  number           Int // 1..10, the order the ten questions are played
  questionId       String
  question         Question       @relation(fields: [questionId], references: [id])
  status           RoundStatus    @default(PENDING)
  openedAt         DateTime?
  closesAt         DateTime?
  lockedAt         DateTime?
  decidedAt        DateTime?
  decision         RoundDecision?
  goalSubmissionId String?        @unique

  submissions    Submission[]
  goalSubmission Submission?  @relation("RoundWinner", fields: [goalSubmissionId], references: [id])

  @@unique([matchId, number])
  @@unique([matchId, questionId])
}

/**
 * ------------------------------- Submissions --------------------------------
 */

model Submission {
  id          String      @id @default(cuid())
  roundId     String
  round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  playerId    String
  player      MatchPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  answer      String
  seq         Int // 1-based submission order inside the round
  submittedAt DateTime    @default(now())

  winningRound Round? @relation("RoundWinner")

  @@unique([roundId, playerId])
  @@index([roundId, seq])
}

/**
 * ----------------------------- Substitutions -------------------------------
 */

enum SubRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model SubstitutionRequest {
  id            String           @id @default(cuid())
  matchId       String
  match         Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team          TeamSide
  playerInId    String
  playerOutId   String
  requestedById String
  requestedBy   User             @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  status        SubRequestStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  decidedAt     DateTime?
}

model Substitution {
  id          String      @id @default(cuid())
  matchId     String
  match       Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team        TeamSide
  playerIn    MatchPlayer @relation("SubPlayerIn", fields: [playerInId], references: [id])
  playerInId  String
  playerOut   MatchPlayer @relation("SubPlayerOut", fields: [playerOutId], references: [id])
  playerOutId String
  at          DateTime    @default(now())
}

/**
 * ------------------------------ Conduct cards ------------------------------
 */

enum IncidentType {
  OUTSIDE_TIME
  ANSWER_MANIPULATION
  ANSWER_SHARING
  ABUSIVE_BEHAVIOUR
  CHAT_SPAM
  ACCOUNT_MISUSE
  UNAUTHORIZED_ASSISTANCE
  DISRESPECT_REFEREE
  OTHER
}

enum IncidentAction {
  WARNING
  YELLOW_CARD
  RED_CARD
}

model ConductIncident {
  id       String         @id @default(cuid())
  matchId  String
  match    Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId String
  player   MatchPlayer    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type     IncidentType
  action   IncidentAction
  note     String?
  at       DateTime       @default(now())
}

/**
 * -------------------------------- Timeline ---------------------------------
 */

enum TimelineType {
  KICKOFF
  QUESTION_OPEN
  ANSWERS_LOCKED
  GOAL
  NO_GOAL
  SUBSTITUTION
  CARD
  FULL_TIME
  PENALTY_SAVED
  PENALTY_SCORED
  PENALTY_MISS
  PENALTY_SHOOTOUT_START
  PENALTY_SHOOTOUT_END
}

model TimelineEvent {
  id           String       @id @default(cuid())
  matchId      String
  match        Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type         TimelineType
  roundNumber  Int?
  label        String // human readable one-liner, e.g. "GOAL — David (Newton) 1–0"
  detail       String? // optional second line
  authoredById String?
  authoredBy   User?        @relation("TimelineAuthor", fields: [authoredById], references: [id])
  seq          Int
  createdAt    DateTime     @default(now())

  @@index([matchId, seq])
}

/**
 * --------------------------------- Teams -----------------------------------
 */

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  code      String // short tag, e.g. "LAG"
  createdAt DateTime @default(now())

  members            TeamPlayer[]
  competitionEntries CompetitionTeam[]
  homeMatches        Match[]           @relation("TeamHomeMatches")
  awayMatches        Match[]           @relation("TeamAwayMatches")

  @@index([slug])
}

model TeamPlayer {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  number    Int // squad number 1..8
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@unique([teamId, number])
  @@index([userId])
}

/**
 * ------------------------------- Competitions ------------------------------
 */

enum CompetitionType {
  LEAGUE // round-robin, standings table
  CUP // single-elimination knockout bracket
  LEAGUE_CUP // group stage then knockout
  CUSTOM // manual fixture placement
}

enum CompetitionStatus {
  DRAFT
  ACTIVE
  FINISHED
}

model Competition {
  id     String            @id @default(cuid())
  slug   String            @unique
  name   String
  type   CompetitionType   @default(LEAGUE)
  status CompetitionStatus @default(DRAFT)
  season String // e.g. "2026/27"

  // Wizard settings (optional)
  groupsCount   Int? // LEAGUE_CUP: number of groups
  teamsPerGroup Int? // LEAGUE_CUP: teams per group
  topAdvancing  Int? // LEAGUE_CUP: top N from each group advance
  roundsCount   Int? // LEAGUE: number of rounds
  countdownSecs Int? // match countdown seconds override
  createdAt     DateTime @default(now())

  teams          CompetitionTeam[]
  matches        Match[]
  fantasyEntries FantasyEntry[]
}

model CompetitionTeam {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  seed          Int? // knockout seeding / league order
  createdAt     DateTime    @default(now())

  @@unique([competitionId, teamId])
}

/**
 * ----------------------------- Penalty shootout ----------------------------
 */

model PenaltyShootout {
  id         String   @id @default(cuid())
  matchId    String   @unique
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status     String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETE
  teamAScore Int      @default(0)
  teamBScore Int      @default(0)
  winner     String? // "HOME" | "AWAY"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kicks PenaltyKick[]
}

model PenaltyKick {
  id         String          @id @default(cuid())
  shootoutId String
  shootout   PenaltyShootout @relation(fields: [shootoutId], references: [id], onDelete: Cascade)
  team       String // "HOME" | "AWAY"
  score      Boolean
  sequence   Int // 1-based kick order
  createdAt  DateTime        @default(now())

  @@unique([shootoutId, sequence])
}

/**
 * ------------------------------- Fantasy -----------------------------------
 */

model FantasyEntry {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  points        Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  picks FantasyPick[]

  @@unique([competitionId, userId])
  @@index([competitionId, points])
}

model FantasyPick {
  id            String       @id @default(cuid())
  entryId       String
  entry         FantasyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  competitionId String
  playerUserId  String
  createdAt     DateTime     @default(now())

  @@unique([entryId, playerUserId])
  @@unique([competitionId, entryId, playerUserId])
  @@index([competitionId, playerUserId])
}

/**
 * ---------------------------- Player of the Match --------------------------
 */

model PotmVote {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    User     @relation("PlayerVotes", fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([matchId, userId])
}

/**
 * ----------------------------------- Chat ----------------------------------
 */

model ChatMessage {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
}
